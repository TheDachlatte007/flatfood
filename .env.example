# =============================================================================
# Flatfood Environment Configuration
# =============================================================================

# Storage directory (defaults to ./data locally, or /data in Docker)
DATA_DIR=./data

# Google Gemini API Key for Receipt Parsing & Vision
# Erstelle einen API-Key unter https://aistudio.google.com mit deinem Cloud-Projekt
GEMINI_API_KEY=

# Gemini Vision Model (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Parser Selection: auto | gemini | ollama | mock | none
PARSER=auto

# Optional: Local Ollama Fallback (if PARSER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Optional: Simple PIN protection for Web UI (leave empty for open LAN access)
APP_PIN=

# Maximum receipt image upload size in MB
MAX_UPLOAD_MB=15
